# ==============================================================================
# FindX Platform -- Demo Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to '.env' in your local project root and enter your credentials.
#
# Terminal command:
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (Linux / macOS / PowerShell)

# ------------------------------------------------------------------------------
# 1. LIVE GMAIL SMTP EMAIL CONFIGURATION (For OTP & Official Alerts)
# ------------------------------------------------------------------------------
# Steps to obtain your 16-character Google App Password:
# 1. Enable 2-Step Verification on your Google account: https://myaccount.google.com/security
# 2. Go to Google App Passwords: https://myaccount.google.com/apppasswords
# 3. Create an App Name (e.g. FindX) and click Create.
# 4. Copy the generated 16-character code and paste it below.

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password
DEFAULT_FROM_EMAIL=FindX Platform <your_email@gmail.com>

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION (For AI Verification & Chat Evaluation)
# ------------------------------------------------------------------------------
# Get your free Gemini API Key from Google AI Studio:
# https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here
